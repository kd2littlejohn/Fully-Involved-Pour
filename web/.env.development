# Dev-only: bypasses real Google sign-in and Firestore reads/writes with a
# fixture user + collection, so pages can be built/verified against
# realistic populated data without clicking through Google OAuth each time.
# Never applies to `npm run build` (production mode). To test real Google
# sign-in locally, override in a git-ignored .env.development.local with
# VITE_MOCK_AUTH=false.
VITE_MOCK_AUTH=true
