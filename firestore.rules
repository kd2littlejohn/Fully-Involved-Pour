rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's whole collection (bottles/pours/memories/etc.) lives in
    // one document here (see web/src/data/repositories/userDoc.ts) —
    // private to the signed-in owner only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Username uniqueness registry (web/src/data/repositories/username.ts).
    // Reads are public so anyone claiming a username can check availability
    // before they own the doc; a user can only claim a free username, or
    // rewrite one they already hold — never take over someone else's.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }

    // Public username -> profile lookup doc (same repository). Owner-only
    // write, public read — that's the point of a public profile doc.
    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Compare/Faceoff votes (web/src/features/faceoff/repository.ts). Public
    // read so vote tallies can be shown to everyone; a user can only write
    // their own vote, matching the app's own {pairKey}_{uid} doc id and
    // voterUid field convention.
    match /faceoffVotes/{voteId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.voterUid == request.auth.uid
                   && voteId == request.resource.data.pairKey + '_' + request.auth.uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
