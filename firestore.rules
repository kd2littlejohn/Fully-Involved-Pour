rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared by the Blind Room rules below. A room is "revealed" once its
    // host has flipped this one field on this one document — a single
    // atomic write with no multi-document race window, which is what makes
    // gating reads on it safe without a Cloud Function (see blindRoomSecrets
    // and the responses/ranking subcollections further down).
    //
    // 'completed' counts too — it's the state Finish Blind moves a room to
    // *from* 'revealed' (see blindRoom.ts completeBlind), purely to file it
    // under Recent Blinds instead of Active; it never un-reveals anything a
    // participant already saw. Without this, every blind a host finishes
    // would silently cut off every other participant's read access to it —
    // found while building Home's Last Blind card, which needs to resolve
    // the winning bottle for whichever participant is looking, not just host.
    function isBlindRevealed(roomId) {
      return get(/databases/$(database)/documents/blindRooms/$(roomId)).data.state in ['revealed', 'completed'];
    }

    function isBlindParticipant(roomId, uid) {
      return exists(/databases/$(database)/documents/blindRooms/$(roomId)/participants/$(uid));
    }

    // Each user's whole collection (bottles/pours/memories/etc.) lives in
    // one document here (see web/src/data/repositories/userDoc.ts) —
    // private to the signed-in owner only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Username uniqueness registry (web/src/data/repositories/username.ts).
    // Reads are public so anyone claiming a username can check availability
    // before they own the doc; a user can only claim a free username, or
    // rewrite one they already hold — never take over someone else's.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }

    // Public username -> profile lookup doc (same repository). Owner-only
    // write, public read — that's the point of a public profile doc.
    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Compare/Faceoff votes (web/src/features/faceoff/repository.ts). Public
    // read so vote tallies can be shown to everyone; a user can only write
    // their own vote, matching the app's own {pairKey}_{uid} doc id and
    // voterUid field convention.
    match /faceoffVotes/{voteId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.voterUid == request.auth.uid
                   && voteId == request.resource.data.pairKey + '_' + request.auth.uid;
    }

    // Blind Room — remote blind tastings (web/src/data/repositories/blindRoom.ts).
    // Room config is public-read (the join-preview screen needs to show
    // room info before a visitor has joined, or even signed in); only the
    // host may write it. Bottle identities never live on this document —
    // see blindRoomSecrets below, the actual security boundary.
    match /blindRooms/{roomId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.hostUid == request.auth.uid;
      // Host-only, any state — deleteBlindRoom (blindRoom.ts) tears down
      // every participant's own subcollections first, in the same batch,
      // so by the time this doc itself is deleted nothing is left orphaned.
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      // Each participant's own doc. Readable by the host and by any other
      // participant already in the room (the lobby roster needs to show
      // everyone's status), never by a non-member. Writable only by the
      // participant themselves — not even the host may edit someone else's
      // participant record.
      //
      // This rule's OR'd get()/exists() lookups are fine for a `get` and
      // for the plain, single-path roster listing (no `where` filter) that
      // useBlindRoom.ts does — but NOT for getMyBlindRooms' collection-group
      // query across every room's participants filtered by uid (see the
      // separate `{path=**}/participants` rule below, which is what
      // actually governs that query).
      match /participants/{uid} {
        allow read: if request.auth != null
                     && (resource.data.uid == request.auth.uid
                         || get(/databases/$(database)/documents/blindRooms/$(roomId)).data.hostUid == request.auth.uid
                         || exists(/databases/$(database)/documents/blindRooms/$(roomId)/participants/$(request.auth.uid)));
        allow create: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null && request.auth.uid == uid;
        // Host-only — part of the same deleteBlindRoom teardown as the room
        // doc itself; a participant can never delete their own record (they
        // can only "remove it from my list" client-side, see
        // web/src/data/hiddenBlindRooms.ts, which never touches Firestore).
        allow delete: if request.auth != null
                       && get(/databases/$(database)/documents/blindRooms/$(roomId)).data.hostUid == request.auth.uid;

        // A participant's private per-pour tasting notes (reaction, nose/
        // palate/finish, guesses, FIP score). Self-only before reveal — not
        // even the host can read another participant's responses, which is
        // the literal "other participants' answers remain hidden"
        // requirement. Once locked, immutable: the participant themselves
        // can no longer edit it either, enforced here rather than only in
        // the UI, so a locked answer is a real commitment. Readable by any
        // participant (not just the author) once the host reveals — that's
        // what powers the compare-results screen.
        match /responses/{pourLabel} {
          allow read: if request.auth != null
                       && (request.auth.uid == uid
                           || (isBlindRevealed(roomId) && isBlindParticipant(roomId, request.auth.uid)));
          allow create: if request.auth != null && request.auth.uid == uid;
          allow update: if request.auth != null && request.auth.uid == uid && resource.data.status != 'locked';
          allow delete: if request.auth != null
                         && get(/databases/$(database)/documents/blindRooms/$(roomId)).data.hostUid == request.auth.uid;
        }

        // A participant's private final ranking of the pours — same access
        // shape as responses above (self-only + immutable-once-locked
        // before reveal, readable by any participant after).
        match /ranking/{rankingId} {
          allow read: if request.auth != null
                       && (request.auth.uid == uid
                           || (isBlindRevealed(roomId) && isBlindParticipant(roomId, request.auth.uid)));
          allow create: if request.auth != null && request.auth.uid == uid;
          allow update: if request.auth != null && request.auth.uid == uid && resource.data.status != 'locked';
          allow delete: if request.auth != null
                         && get(/databases/$(database)/documents/blindRooms/$(roomId)).data.hostUid == request.auth.uid;
        }

        // A participant's private mid-tasting head-to-head calls ("which
        // would you rather pour another glass of?"). Same self-only-until-
        // reveal access shape as responses/ranking above; no lock concept —
        // each comparison is a single quick call made once and never
        // revisited by the UI, so there's no draft state worth protecting.
        match /comparisons/{comparisonId} {
          allow read: if request.auth != null
                       && (request.auth.uid == uid
                           || (isBlindRevealed(roomId) && isBlindParticipant(roomId, request.auth.uid)));
          allow create: if request.auth != null && request.auth.uid == uid;
          allow update: if request.auth != null && request.auth.uid == uid;
          allow delete: if request.auth != null
                         && get(/databases/$(database)/documents/blindRooms/$(roomId)).data.hostUid == request.auth.uid;
        }
      }
    }

    // getMyBlindRooms (web/src/data/repositories/blindRoom.ts) — which
    // backs the Blind Room landing page's Active/Recent lists, Journey's
    // Blind Stories section, and Bottle Details' Blind History — runs a
    // collection-group query over every room's `participants` subcollection
    // filtered by `where('uid', '==', callerUid)`. Real Cloud Firestore only
    // allows a collection-group list request when it can prove the rule
    // holds using nothing but the query's own `where` clause; it will NOT
    // do that proof if the rule includes any get()/exists() cross-document
    // lookup, even as just one branch of an `||` that would otherwise be
    // sufficient on its own — so this has to be a separate, deliberately
    // simple rule kept apart from the richer get()/exists()-based one on
    // `blindRooms/{roomId}/participants/{uid}` above (which stays in
    // charge of `get` and the plain, single-room roster `list`). The local
    // rules-unit-testing emulator does not enforce this restriction, so a
    // passing emulator test is not proof a collection-group query like
    // this one works in production — it silently didn't, for a long time.
    match /{path=**}/participants/{uid} {
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Short human-friendly room code -> roomId index, used by the Join
    // flow. Public read (code lookup happens before joining, possibly
    // before signing in); only the actual host of the referenced room may
    // create the mapping (checked by reading the room doc's hostUid), and
    // it's immutable once created — a code collision just means the client
    // picks a different random code, never overwrites an existing one.
    match /blindRoomCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null
                     && get(/databases/$(database)/documents/blindRooms/$(request.resource.data.roomId)).data.hostUid == request.auth.uid;
      allow update: if false;
      // Part of deleteBlindRoom's teardown — same host-only check, but
      // reads `resource.data.roomId` (this doc's own data) since deletes
      // have no `request.resource`.
      allow delete: if request.auth != null
                     && get(/databases/$(database)/documents/blindRooms/$(resource.data.roomId)).data.hostUid == request.auth.uid;
    }

    // The hidden bottle mapping — the actual security boundary for Blind
    // Room. Always host-readable/writable; readable by a participant only
    // once the host has revealed (see isBlindRevealed above) — never
    // writable by a participant, at any point. Until reveal, bottle
    // identities are simply never present in any document a participant's
    // client is permitted to read, not merely hidden in the UI (blurred/
    // CSS-hidden/omitted from rendering) while still present in the
    // network response.
    match /blindRoomSecrets/{roomId} {
      allow read: if request.auth != null
                   && (get(/databases/$(database)/documents/blindRooms/$(roomId)).data.hostUid == request.auth.uid
                       || (isBlindRevealed(roomId) && isBlindParticipant(roomId, request.auth.uid)));
      allow write: if request.auth != null
                    && get(/databases/$(database)/documents/blindRooms/$(roomId)).data.hostUid == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Friends / social (web/src/data/repositories/{relationships,
    // sharedMoments,recommendations,notifications,sharedCollections}.ts).
    // "Share the pour, not your whole life" — every rule below only ever
    // grants access tied to a specific, explicit relationship or share,
    // never a broad allow read/write.

    // relationships/{uidA}_{uidB} — doc id is always the two uids sorted
    // lexicographically, regardless of who initiated. A block is stored as
    // a symmetric doc too (status:'blocked'); `requestedBy` is whichever
    // uid actually did the blocking, and — deliberately, for simplicity —
    // isBlockedBetween() below treats a block as stopping interaction in
    // BOTH directions rather than only restricting the blocked party. That
    // is a conscious simplification: a block still fully achieves "this
    // pair can no longer interact," just without distinguishing who
    // technically initiated it for interaction *rules* (relationship
    // *deletion* below does still respect direction — see relationships'
    // own delete rule).
    function relationshipId(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    function friendsWith(uidA, uidB) {
      let relId = relationshipId(uidA, uidB);
      return exists(/databases/$(database)/documents/relationships/$(relId))
        && get(/databases/$(database)/documents/relationships/$(relId)).data.status == 'friends';
    }

    function isBlockedBetween(uidA, uidB) {
      let relId = relationshipId(uidA, uidB);
      return exists(/databases/$(database)/documents/relationships/$(relId))
        && get(/databases/$(database)/documents/relationships/$(relId)).data.status == 'blocked';
    }

    function friendRequestId(senderId, receiverId) {
      return senderId + '_' + receiverId;
    }

    function hasPendingRequestFrom(senderId, receiverId) {
      let reqId = friendRequestId(senderId, receiverId);
      return exists(/databases/$(database)/documents/friendRequests/$(reqId))
        && get(/databases/$(database)/documents/friendRequests/$(reqId)).data.status == 'pending';
    }

    // Shared by storyReactions/storyComments below — one place that
    // fetches a sharedMoments doc and answers "can this uid see it," so
    // neither rule repeats the same get() three times over.
    function canAccessMoment(momentId, uid) {
      let moment = get(/databases/$(database)/documents/sharedMoments/$(momentId)).data;
      return moment.ownerId == uid || uid in moment.participantIds;
    }

    function momentOwner(momentId) {
      return get(/databases/$(database)/documents/sharedMoments/$(momentId)).data.ownerId;
    }

    match /relationships/{pairId} {
      // The !exists() branch matters more than it looks: getFriendStatus
      // (relationships.ts) does a plain get() on this exact path for every
      // Friend Search result, and the common case is two people who have
      // never interacted — no relationship doc exists yet. Firestore
      // evaluates resource.data against a document that doesn't exist by
      // throwing, which surfaces to the client as permission-denied, not
      // "not found" — so without this branch, searching for literally any
      // stranger (the normal case) broke the whole search result list.
      // Allowing the read to succeed when the doc doesn't exist leaks
      // nothing (there's no data to leak) and lets the client correctly
      // see "not found" and derive status 'none', same as if there were no
      // rule on this path at all for that one case.
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/relationships/$(pairId)) || request.auth.uid in resource.data.userIds);
      // 'friends' can only ever be created/overwritten by the RECEIVER of a
      // real, still-pending request from whoever `requestedBy` names — this
      // is what actually turns "accept" into a relationship, not a bare
      // client claim. 'blocked' can only be created by the blocker
      // themselves, unconditionally (blocking never needs the other
      // party's consent).
      allow create, update: if request.auth != null
        && request.auth.uid in request.resource.data.userIds
        && (
          (request.resource.data.status == 'friends'
            && request.resource.data.requestedBy != request.auth.uid
            && hasPendingRequestFrom(request.resource.data.requestedBy, request.auth.uid))
          || (request.resource.data.status == 'blocked' && request.resource.data.requestedBy == request.auth.uid)
        );
      // Either side of a friendship can end it; only the blocker can lift
      // their own block — the blocked party can never unblock themselves.
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.userIds
        && (resource.data.status == 'friends' || resource.data.requestedBy == request.auth.uid);
    }

    // friendRequests/{senderId}_{receiverId} — direction lives in the doc
    // id itself, unlike relationships.
    match /friendRequests/{requestId} {
      // Same !exists() reasoning as relationships/{pairId} above —
      // getFriendStatus does two of these get()s (outgoing and incoming)
      // per search result, and "no request exists between these two
      // people" is the common case, not the exception.
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/friendRequests/$(requestId))
            || request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.status == 'pending'
        && requestId == friendRequestId(request.resource.data.senderId, request.resource.data.receiverId)
        && !isBlockedBetween(request.resource.data.senderId, request.resource.data.receiverId);
      // The sender can only cancel; the receiver can only accept or
      // decline — never the other way around — and only while still
      // pending (a decided request is a permanent record, not reopenable).
      allow update: if request.auth != null
        && resource.data.status == 'pending'
        && (
          (request.auth.uid == resource.data.senderId && request.resource.data.status == 'cancelled')
          || (request.auth.uid == resource.data.receiverId && request.resource.data.status in ['accepted', 'declined'])
        );
    }

    // sharedMoments/{id} — a Pour Story shared with specific tagged
    // friends (web/src/features/friends/shareStoryOnSave.ts). Content is a
    // snapshot taken at share time (see data/types.ts SharedMoment) since
    // participants can never read the owner's private users/{uid} doc.
    match /sharedMoments/{momentId} {
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.participantIds);
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.acceptedParticipantIds.size() == 0;
      // The owner can edit/moderate anything; a tagged participant may only
      // ever touch their own membership in acceptedParticipantIds — never
      // the snapshot, never anyone else's acceptance.
      allow update: if request.auth != null
        && (
          resource.data.ownerId == request.auth.uid
          || (request.auth.uid in resource.data.participantIds
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedParticipantIds']))
        );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // A participant's own optional tasting impression on someone else's
      // shared moment — never edits the original story (see
      // SharedMomentParticipantNote in data/types.ts).
      match /participantNotes/{uid} {
        allow read: if request.auth != null && canAccessMoment(momentId, request.auth.uid);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // storyReactions/{sharedMomentId}_{uid} — one per person per story;
    // reacting again just overwrites this same doc (see
    // data/repositories/sharedMoments.ts setReaction).
    match /storyReactions/{reactionId} {
      allow read: if request.auth != null && canAccessMoment(resource.data.sharedMomentId, request.auth.uid);
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && reactionId == request.resource.data.sharedMomentId + '_' + request.resource.data.uid
        && canAccessMoment(request.resource.data.sharedMomentId, request.auth.uid)
        && !isBlockedBetween(request.auth.uid, momentOwner(request.resource.data.sharedMomentId));
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // storyComments/{id} — short conversation attached to one shared
    // moment. Deletable by its own author, or by the story's owner
    // moderating their own story (see data/repositories/sharedMoments.ts
    // deleteComment; enforced here, not just in the UI).
    match /storyComments/{commentId} {
      allow read: if request.auth != null && canAccessMoment(resource.data.sharedMomentId, request.auth.uid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorId
        && canAccessMoment(request.resource.data.sharedMomentId, request.auth.uid)
        && !isBlockedBetween(request.auth.uid, momentOwner(request.resource.data.sharedMomentId));
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.authorId || request.auth.uid == momentOwner(resource.data.sharedMomentId));
    }

    // recommendations/{id} — a bottle recommendation, sender to recipient
    // (web/src/data/repositories/recommendations.ts). Same snapshot
    // reasoning as sharedMoments: bottleId only resolves in the sender's
    // own private collection.
    match /recommendations/{recommendationId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.status == 'pending'
        && !isBlockedBetween(request.resource.data.senderId, request.resource.data.recipientId);
      // Only the recipient ever changes status (added-to-wishlist/
      // dismissed) — the sender's copy is otherwise immutable history.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);
    }

    // notifications/{id} — always written by the ACTOR on behalf of the
    // recipient (web/src/data/repositories/notifications.ts
    // createNotification is called by whoever performed the triggering
    // action), so create checks actorId, not recipientId.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.actorId;
      // The recipient may only ever flip `read` — never rewrite what the
      // notification says happened.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.recipientId;
    }

    // sharedCollections/{uid} — an OWNER-COMPUTED, already-privacy-filtered
    // projection of their own bottles/wishlist (see
    // data/repositories/sharedCollections.ts buildSharedCollectionProjection
    // — collectionVisibility/wishListVisibility are applied client-side at
    // write time, since Firestore rules can't filter individual array
    // elements out of a read). Only the owner ever writes it; read access
    // here just has to match what their own profiles/{uid}.privacy already
    // promises a friend or any FIP user.
    match /sharedCollections/{ownerUid} {
      allow read: if request.auth != null
        && (
          request.auth.uid == ownerUid
          || (friendsWith(request.auth.uid, ownerUid)
              && (get(/databases/$(database)/documents/profiles/$(ownerUid)).data.privacy.collectionVisibility != 'private'
                  || get(/databases/$(database)/documents/profiles/$(ownerUid)).data.privacy.wishListVisibility != 'private'))
          || get(/databases/$(database)/documents/profiles/$(ownerUid)).data.privacy.collectionVisibility == 'fip-users'
          || get(/databases/$(database)/documents/profiles/$(ownerUid)).data.privacy.wishListVisibility == 'fip-users'
        );
      allow write: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
